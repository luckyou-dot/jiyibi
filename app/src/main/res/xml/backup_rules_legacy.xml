<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下（API 30-）的自动备份规则，作用同 backup_rules.xml：
  把 AI API Key 与未识别通知原文排除出备份。
-->
<full-backup-content>
    <exclude domain="file" path="datastore/ai_preferences.preferences_pb" />
    <exclude domain="file" path="datastore/unmatched_notifications.preferences_pb" />
</full-backup-content>

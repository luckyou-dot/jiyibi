<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：用于拍照识别小票/发票 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知：自动记账成功后的横幅提醒（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网络：AI 智能识别（用户自行配置 API Key 后调用 OpenAI 兼容接口） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".JiYiBiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JiYiBi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiYiBi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 移除默认 WorkManagerInitializer，使用 on-demand 初始化 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <!--
            支付通知自动记账监听服务。
            需要用户在「设置 → 通知 → 通知使用权」里手动授权后才生效，
            见 NotificationAccessHelper 与「我的 → 自动记账」页的引导入口。
        -->
        <service
            android:name=".core.notify.PaymentNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            支付页面识别服务（无障碍，可选增强）。
            补足通知监听的盲区：用户正在微信 / 支付宝里扫码、转账时没有系统通知可听，
            本服务在支付成功页面出现时读取屏幕文字当场记账。
            需要用户在「设置 → 无障碍」里手动开启，见 AccessibilityAccessHelper。
        -->
        <service
            android:name=".core.notify.PaymentAccessibilityService"
            android:exported="true"
            android:label="@string/payment_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/payment_accessibility_config" />
        </service>

        <!-- 桌面小组件（Glance）将在 ui/widget 下声明 -->
    </application>
</manifest>
